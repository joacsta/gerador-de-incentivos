# Ambientes exibidos pela CLI e usados para decidir entre teste e produção.
AMBIENTE_TESTE=teste
AMBIENTE_PRINCIPAL=principal

# Use uma URL do SQLAlchemy. Exemplos:
# SQLite:      sqlite:///./incentivos.db
# PostgreSQL:  postgresql+psycopg://usuario:senha@localhost:5432/incentivos
# MySQL:       mysql+pymysql://usuario:senha@localhost:3306/incentivos
DATABASE_URL_TESTE=sqlite:///./incentivos.db
DATABASE_URL_PRINCIPAL=

# Usada como fallback quando o ambiente não tiver uma URL própria.
DATABASE_URL=

# Schema para bancos que suportam schema. SQLite ignora este valor.
DB_SCHEMA=ModuloPrincipal
